{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "inbounds": [
    {
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "dns_mode": "disabled",
      "stack": "system",
      "strict_route": true,
      "tag": "tun-in",
      "type": "tun"
    }
  ],
  "log": {
    "level": "info",
    "timestamp": true
  },
  "outbounds": [
    {
      "server": "127.0.0.1",
      "server_port": 1080,
      "tag": "byedpi-out",
      "type": "socks"
    },
    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "final": "direct",
    "rules": [
      {
        "action": "sniff",
        "sniffer": [
          "tls",
          "http",
          "quic"
        ],
        "timeout": "500ms"
      },
      {
        "action": "route",
        "outbound": "direct",
        "process_name": [
          "ciadpi",
          "sing-box"
        ]
      },
      {
        "action": "route",
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "action": "reject",
        "domain_suffix": [
          "4shared.com",
          "bitly.com",
          "cutt.ly",
          "ggpht.com",
          "googlevideo.com",
          "nnmclub.to",
          "nyaa.si",
          "pastebin.com",
          "rbxcdn.com",
          "roblox.com",
          "rutor.org",
          "rutracker.org",
          "t2m.io",
          "wattpad.com",
          "wikileaks.org",
          "youtu.be",
          "youtube.com",
          "youtubei.googleapis.com",
          "ytimg.com"
        ],
        "method": "default",
        "network": "udp",
        "no_drop": true,
        "port": 443
      },
      {
        "action": "route",
        "network": "udp",
        "outbound": "direct"
      },
      {
        "action": "route",
        "domain_suffix": [
          "4shared.com",
          "bitly.com",
          "cutt.ly",
          "ggpht.com",
          "googlevideo.com",
          "nnmclub.to",
          "nyaa.si",
          "pastebin.com",
          "rbxcdn.com",
          "roblox.com",
          "rutor.org",
          "rutracker.org",
          "t2m.io",
          "wattpad.com",
          "wikileaks.org",
          "youtu.be",
          "youtube.com",
          "youtubei.googleapis.com",
          "ytimg.com"
        ],
        "network": "tcp",
        "outbound": "byedpi-out",
        "port": [
          80,
          443
        ]
      }
    ]
  }
}
